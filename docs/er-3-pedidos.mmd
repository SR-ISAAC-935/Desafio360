    Usuarios {
        int IDUsuario PK
    }
    VariantesProducto {
        int IDVariante PK
    }
    Direcciones {
        int IDDireccion PK
    }
    Cupones {
        int IDCupon PK
    }
    EstadosPedido {
        int IDEstadoPedido PK
        nvarchar NombreEstado
    }
    Pedidos {
        int IDPedido PK
        int IDUsuario FK
        int IDDireccion FK
        int IDEstadoPedido FK
        int IDCupon FK
        decimal Subtotal
        decimal Descuento
        decimal Total
        decimal MontoIVA
        varchar LlaveIdempotencia
        datetime2 FechaPedido
        rowversion Version
    }
    PedidoDetalle {
        int IDPedidoDetalle PK
        int IDPedido FK
        int IDVariante FK
        int Cantidad
        decimal PrecioUnitario
        decimal DescuentoLinea
        decimal TotalLinea
        int CantidadDevuelta
    }
    UsosCupon {
        int IDUsoCupon PK
        int IDCupon FK
        int IDUsuario FK
        int IDPedido FK
        datetime2 FechaUso
    }
    TransicionesEstadoPedido {
        int IDEstadoOrigen PK,FK
        int IDEstadoDestino PK,FK
    }
    HistorialEstadosPedido {
        int IDHistorial PK
        int IDPedido FK
        int IDEstadoAnterior FK
        int IDEstadoNuevo FK
        int IDUsuario FK
        datetime2 FechaCambio
        nvarchar Comentario
    }
    Pagos {
        int IDPago PK
        int IDPedido FK
        decimal Monto
        varchar Metodo
        varchar Estado
        varchar Referencia
        varchar LlaveIdempotencia
        datetime2 FechaPago
    }
    Devoluciones {
        int IDDevolucion PK
        int IDPedido FK
        int IDUsuario FK
        varchar Tipo
        nvarchar Motivo
        decimal MontoReembolso
        datetime2 FechaDevolucion
    }
    DevolucionDetalle {
        int IDDevolucionDetalle PK
        int IDDevolucion FK
        int IDPedidoDetalle FK
        int Cantidad
    }
